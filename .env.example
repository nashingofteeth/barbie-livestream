# Owncast Admin Credentials
# These are used for the automated theme setup script
# Copy this file to .env and update with your actual credentials

# Default admin password (CHANGE THIS IMMEDIATELY!)
OWNCAST_ADMIN_PASSWORD=abc123

# Owncast server URL (default for local Docker)
OWNCAST_URL=http://localhost:2001

# Admin username (usually 'admin', don't change unless you know what you're doing)
OWNCAST_ADMIN_USER=admin
